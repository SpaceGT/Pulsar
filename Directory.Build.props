<Project>
  <!-- Override Project Settings -->
  <PropertyGroup>
    <!-- Target platform for Pulsar build -->
    <TargetPlatform></TargetPlatform>

    <!-- Folder where Pulsar will be deployed -->
    <Pulsar></Pulsar>

    <!-- Folder containing SpaceEngineers.exe -->
    <Bin64></Bin64>

    <!-- Folder containing SpaceEngineers2.exe -->
    <Game2></Game2>

    <!-- Folder containing Linux Steamworks.NET and steam_api -->
    <Steamworks></Steamworks>
  </PropertyGroup>

  <!-- Local developer overrides for the settings above; ignored by Git (*.user).
       Copy the first PropertyGroup of this file into Directory.Build.props.user
       and fill in your local paths there. -->
  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />

  <!-- Default Project Settings -->
  <PropertyGroup>
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</TargetPlatform>
    <TargetPlatform Condition="'$(TargetPlatform)' == '' and $([MSBuild]::IsOSPlatform('Linux'))">Linux</TargetPlatform>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Bin64 Condition="'$(Bin64)' == ''">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 244850@InstallLocation)\Bin64</Bin64>
    <Game2 Condition="'$(Game2)' == ''">$(registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 1133870@InstallLocation)\Game2</Game2>
    <Pulsar Condition="'$(Pulsar)' == '' and '$(APPDATA)' != ''">$(APPDATA)\Pulsar</Pulsar>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Bin64 Condition="'$(Bin64)' == '' and '$(HOME)' != ''">$(HOME)/.steam/steam/steamapps/common/SpaceEngineers/Bin64</Bin64>
    <Game2 Condition="'$(Game2)' == '' and '$(HOME)' != ''">$(HOME)/.steam/steam/steamapps/common/SpaceEngineers2/Game2</Game2>
    <Pulsar Condition="'$(Pulsar)' == '' and '$(XDG_CONFIG_HOME)' != ''">$(XDG_CONFIG_HOME)/Pulsar</Pulsar>
    <Pulsar Condition="'$(Pulsar)' == '' and '$(HOME)' != ''">$(HOME)/.config/Pulsar</Pulsar>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetPlatform)' == 'Windows'">
    <SteamApiFileName>steam_api64.dll</SteamApiFileName>
    <ExecutableExtension>.exe</ExecutableExtension>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetPlatform)' == 'Linux'">
    <SteamApiFileName>libsteam_api.so</SteamApiFileName>
    <ExecutableExtension>.bin</ExecutableExtension>
  </PropertyGroup>
</Project>
