<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pulsar.Interface.App">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Window">
      <Setter Property="Icon" Value="avares://Interface/Assets/icon.ico" />
    </Style>
  </Application.Styles>
</Application>
