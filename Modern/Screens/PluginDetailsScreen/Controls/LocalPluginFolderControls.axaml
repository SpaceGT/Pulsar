<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Pulsar.Modern.Screens.PluginDetailsScreen.Controls.LocalPluginFolderControls"
             xmlns:vm="using:Pulsar.Modern.Screens.PluginDetailsScreen"
             x:DataType="vm:PluginDetailsScreenViewModel">
    <Grid HorizontalAlignment="Center">
        <CheckBox Name="BuildConfigCheckbox"
                  HorizontalAlignment="Center"
                  Content="Debug Build"
                  IsEnabled="{Binding Plugin.PluginConfig, Converter={x:Static ObjectConverters.IsNotNull}}"
                  IsChecked="{Binding Plugin.DebugBuild}"/>
    </Grid>
</UserControl>
